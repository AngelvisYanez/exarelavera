ErrorDocument 404     /administrador/FRONT/not_found.html
ErrorDocument 403     /administrador/FRONT/forbidden.html
ErrorDocument 500     /administrador/FRONT/fatalerror.html

# ERP: salida HTML en UTF-8 (conexion mysqli utf8 convierte desde tablas latin1).
AddDefaultCharset UTF-8

<FilesMatch "^\.env(\.example)?$">
    Require all denied
</FilesMatch>


#RewriteEngine On
#RewriteCond %{HTTPS} off
#RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
#RewriteRule ^(.*)$ /index.php [L,R=302]