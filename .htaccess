ErrorDocument 404     /administrador/FRONT/not_found.html
ErrorDocument 403     /administrador/FRONT/forbidden.html
ErrorDocument 500     /administrador/FRONT/fatalerror.html

# Deny access to sensitive files
<FilesMatch "^\.env(\.example)?$">
    Require all denied
</FilesMatch>

<FilesMatch "^(phpinfo|composer)\.php$">
    Require all denied
</FilesMatch>

RewriteEngine On

# Deny access to QUARANTINE directory (potential security risk)
RewriteRule ^QUARANTINE(/|$) - [F,L]

# API REST Routing
RewriteCond %{REQUEST_URI} ^/api/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^api/(.*)$ api/index.php [QSA,L]

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options nosniff
    Header always set X-Frame-Options SAMEORIGIN
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # HSTS (uncomment when HTTPS is confirmed working)
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Disable directory listing
Options -Indexes
