{
  "name": "exa-relavera-tailwind",
  "version": "1.0.0",
  "private": true,
  "description": "Build de Tailwind CSS para el ERP Exa/Relavera (salida en dist/)",
  "scripts": {
    "build": "tailwindcss -i ./src/input.css -o ./dist/tailwind.min.css --minify",
    "watch": "tailwindcss -i ./src/input.css -o ./dist/tailwind.min.css --watch"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "3.4.17"
  }
}
